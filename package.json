{
  "name": "artisans-corner",
  "version": "1.0.0",
  "private": true,
  "description": "Artisan's Corner — Full-stack multi-vendor handmade goods marketplace",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build": "npm run build --prefix client && npm run build --prefix server && node scripts/bundle-api.js",
    "start": "node server/dist/server.js",
    "seed": "npm run seed --prefix server",
    "test": "npm test --prefix server"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0",
    "stripe": "^23.1.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.28.0",
    "@rollup/rollup-linux-x64-musl": "^4.28.0"
  }
}
